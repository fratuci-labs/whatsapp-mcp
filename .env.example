# Optional base directory override (defaults to OS user app-data directory)
# macOS default:   ~/Library/Application Support/whatsapp-mcp
# Windows default: %LOCALAPPDATA%\whatsapp-mcp
# Linux default:   ~/.local/share/whatsapp-mcp
# WHATSAPP_MCP_HOME=/custom/path/whatsapp-mcp

# Optional explicit overrides for SQLite session/messages and decrypted media
# WHATSAPP_MCP_DATA_DIR=/custom/path/whatsapp-mcp/data
# WHATSAPP_MCP_MEDIA_DIR=/custom/path/whatsapp-mcp/media

# Set to "true" to disable wa_send_message tool and block /send at daemon level
WHATSAPP_MCP_READ_ONLY=false

# Log verbosity for WhatsApp client: DEBUG | INFO | WARN | ERROR
WHATSAPP_MCP_LOG_LEVEL=INFO

# Request timeout in seconds between MCP stdio server and background daemon (5-300)
WHATSAPP_MCP_REQUEST_TIMEOUT=45

# Optional custom companion device label shown in WhatsApp Linked Devices
# WHATSAPP_MCP_DEVICE_NAME=WhatsApp MCP
